<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Math World Cup: Practice & Penalty Matches</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <style>
    .stadium-bg { background: radial-gradient(circle at 50% 30%, #0a1a2f 0%, #0b1f33 40%, #030b14 100%); }
    .pitch-grass {
      background: linear-gradient(180deg, #1a7a3c 0%, #0f5a2a 40%, #0a3d1e 100%);
      box-shadow: inset 0 0 30px rgba(0,0,0,0.7), inset 0 0 10px #00000055;
      position: relative; border-radius: 20px;
    }
    .pitch-grass::before {
      content: ""; position: absolute; inset: 0;
      background-image:
        repeating-linear-gradient(90deg, rgba(255,255,255,0.05) 0px, rgba(255,255,255,0.05) 2px, transparent 2px, transparent 40px),
        repeating-linear-gradient(0deg, rgba(255,255,255,0.03) 0px, rgba(255,255,255,0.03) 2px, transparent 2px, transparent 40px);
      border-radius: 20px; pointer-events: none;
    }
    .goal-net-3d {
      background:
        radial-gradient(circle at 30% 20%, rgba(255,255,255,0.25) 0%, transparent 30%),
        repeating-linear-gradient(45deg, #ffffff30 0px, #ffffff30 1px, transparent 1px, transparent 8px),
        repeating-linear-gradient(-45deg, #ffffff20 0px, #ffffff20 1px, transparent 1px, transparent 8px),
        linear-gradient(180deg, #2a3f55 0%, #0f1a24 100%);
      background-blend-mode: overlay, normal, normal, normal;
      box-shadow: inset 0 0 50px #000000aa, 0 10px 20px -5px black;
      border-radius: 8px 8px 0 0;
      border-left: 3px solid #cfd8e0; border-right: 3px solid #cfd8e0; border-top: 6px solid #e8edf2;
      position: relative;
    }
    .goal-net-mesh {
      position: absolute; inset: 0;
      background-image:
        linear-gradient(to right, #ffffff40 1px, transparent 1px),
        linear-gradient(to bottom, #ffffff40 1px, transparent 1px);
      background-size: 12px 12px; opacity: 0.55; mix-blend-mode: overlay;
      pointer-events: none; border-radius: 6px 6px 0 0;
    }
    .goal-frame-3d {
      border-top: 6px solid #eef2f6; border-left: 8px solid #cfd8e3; border-right: 8px solid #cfd8e3;
      border-radius: 12px 12px 0 0;
      box-shadow: 0 -10px 20px -5px #000000aa, inset 0 10px 15px -5px #ffffff33;
      position: relative;
    }
    .ball-3d {
      width: 28px; height: 28px; font-size: 26px; line-height: 28px; text-align: center;
      filter: drop-shadow(0 5px 4px rgba(0,0,0,0.7)) drop-shadow(0 0 10px rgba(255,255,220,0.5));
      transition: transform 0.2s ease-out, filter 0.2s;
      text-shadow: 0 0 8px white, 0 0 16px rgba(255,255,200,0.6);
    }
    .target-corner { filter: drop-shadow(0 0 12px #fbbf24); transition: all 0.2s; }
    .penalty-spot-glow { box-shadow: 0 0 40px 10px rgba(255,255,180,0.4), 0 0 80px 20px rgba(255,255,200,0.1); border-radius: 50%; }

    .timer-ring { transition: stroke-dashoffset 1s linear, stroke 0.3s; }
    @keyframes timerPulse { 0%,100% { transform: scale(1);} 50% { transform: scale(1.12);} }
    .timer-danger { animation: timerPulse 0.6s ease-in-out infinite; }

    @keyframes netBulgeReal {
      0% { transform: scale(1); filter: brightness(1); }
      40% { transform: scale(1.08) translateY(-8px); filter: brightness(1.4); }
      70% { transform: scale(1.02) translateY(-2px); filter: brightness(1.2); }
      100% { transform: scale(1); filter: brightness(1); }
    }
    .animate-net-bulge { animation: netBulgeReal 0.6s cubic-bezier(0.2, 0.9, 0.4, 1); }

    @keyframes kickTopLeftReal {
      0% { transform: scale(1) translate(0, 0); opacity: 1; }
      30% { transform: scale(0.85) translate(-60px, -80px); opacity: 1; }
      70% { transform: scale(0.55) translate(-190px, -200px); opacity: 1; }
      100% { transform: scale(0.3) translate(-280px, -260px); opacity: 0.9; }
    }
    @keyframes kickTopRightReal {
      0% { transform: scale(1) translate(0, 0); opacity: 1; }
      30% { transform: scale(0.85) translate(60px, -80px); opacity: 1; }
      70% { transform: scale(0.55) translate(190px, -200px); opacity: 1; }
      100% { transform: scale(0.3) translate(280px, -260px); opacity: 0.9; }
    }
    .animate-kick-top-left-real { animation: kickTopLeftReal 0.65s cubic-bezier(0.2, 0.8, 0.4, 1) forwards; }
    .animate-kick-top-right-real { animation: kickTopRightReal 0.65s cubic-bezier(0.2, 0.8, 0.4, 1) forwards; }

    @keyframes ballCaughtLeft {
      0%   { transform: scale(1) translate(0, 0); opacity: 1; }
      55%  { transform: scale(0.8) translate(-110px, -130px); opacity: 1; }
      100% { transform: scale(0.55) translate(-158px, -168px) rotate(-12deg); opacity: 1; }
    }
    @keyframes ballCaughtRight {
      0%   { transform: scale(1) translate(0, 0); opacity: 1; }
      55%  { transform: scale(0.8) translate(110px, -130px); opacity: 1; }
      100% { transform: scale(0.55) translate(158px, -168px) rotate(12deg); opacity: 1; }
    }
    .animate-ball-caught-left  { animation: ballCaughtLeft 0.55s cubic-bezier(0.15, 0.85, 0.35, 1) forwards; }
    .animate-ball-caught-right { animation: ballCaughtRight 0.55s cubic-bezier(0.15, 0.85, 0.35, 1) forwards; }

    @keyframes diveLeftReal {
      0% { transform: translate(0, 0) rotate(0deg) scale(1); }
      25% { transform: translate(-50px, -20px) rotate(-20deg) scale(1.05); }
      60% { transform: translate(-150px, 20px) rotate(-55deg) scale(1.1); }
      100% { transform: translate(-185px, 30px) rotate(-75deg) scale(1.05); }
    }
    @keyframes diveRightReal {
      0% { transform: translate(0, 0) rotate(0deg) scale(1); }
      25% { transform: translate(50px, -20px) rotate(20deg) scale(1.05); }
      60% { transform: translate(150px, 20px) rotate(55deg) scale(1.1); }
      100% { transform: translate(185px, 30px) rotate(75deg) scale(1.05); }
    }
    .animate-dive-left  { animation: diveLeftReal 0.5s ease-out forwards; }
    .animate-dive-right { animation: diveRightReal 0.5s ease-out forwards; }

    @keyframes catchPoseLeft {
      0% { transform: translate(0, 0) rotate(0deg) scale(1); }
      100% { transform: translate(-150px, 25px) rotate(-70deg) scale(1.05); }
    }
    @keyframes catchPoseRight {
      0% { transform: translate(0, 0) rotate(0deg) scale(1); }
      100% { transform: translate(150px, 25px) rotate(70deg) scale(1.05); }
    }
    .animate-catch-left  { animation: catchPoseLeft 0.55s cubic-bezier(0.15, 0.85, 0.35, 1) forwards; }
    .animate-catch-right { animation: catchPoseRight 0.55s cubic-bezier(0.15, 0.85, 0.35, 1) forwards; }

    @keyframes kickerRunUp {
      0% { transform: translate(0, 0) scale(1); }
      40% { transform: translate(-6px, -4px) scale(1.03); }
      70% { transform: translate(4px, -6px) scale(1.04); }
      100% { transform: translate(0, 0) scale(1); }
    }
    @keyframes kickerSwing {
      0% { transform: translate(0, 0) rotate(0deg) scale(1); }
      30% { transform: translate(2px, -2px) rotate(8deg) scale(1.02); }
      60% { transform: translate(-2px, 2px) rotate(-14deg) scale(1.03); }
      100% { transform: translate(0, 0) rotate(0deg) scale(1); }
    }
    @keyframes kickerFollowThrough {
      0% { transform: translate(0, 0) rotate(0deg) scale(1); }
      100% { transform: translate(4px, -2px) rotate(16deg) scale(1.05); }
    }
    .animate-kicker-runup { animation: kickerRunUp 0.35s ease-in-out; }
    .animate-kicker-swing { animation: kickerSwing 0.4s ease-in-out; }
    .animate-kicker-follow { animation: kickerFollowThrough 0.5s ease-out forwards; }

    @media (max-width: 640px) {
      .goal-container { width: 100% !important; height: 150px !important; }
      .ball-3d { width: 22px; height: 22px; font-size: 20px; line-height: 22px; }
      #keeperWrapper { transform-origin: center bottom; }
      #kickerWrapper { transform-origin: center bottom; }
    }
  </style>
</head>
<body class="stadium-bg min-h-screen text-white font-sans flex flex-col justify-between select-none">

  <!-- TOP BAR -->
  <header class="bg-slate-900/80 backdrop-blur border-b border-slate-700/50 p-4 sticky top-0 z-50">
    <div class="max-w-4xl mx-auto flex justify-between items-center">
      <div class="flex items-center space-x-3">
        <span class="text-3xl">🏆</span>
        <div>
          <h1 class="text-xl font-bold bg-gradient-to-r from-amber-300 via-yellow-400 to-amber-500 bg-clip-text text-transparent">MATH WORLD CUP</h1>
          <p class="text-xs text-slate-400">Practice &amp; Penalty Matches</p>
        </div>
      </div>
      <button onclick="openTutorial()" class="bg-slate-800 hover:bg-slate-700 border border-slate-600 px-3 py-1.5 rounded-lg text-sm flex items-center gap-2 transition">
        <i class="fas fa-question-circle text-amber-400"></i> How to Play
      </button>
    </div>
  </header>

  <!-- MAIN -->
  <main class="max-w-4xl mx-auto w-full p-4 flex-grow flex flex-col justify-center">

    <!-- HUB -->
    <div id="levelHub" class="space-y-6">

      <!-- MODE CARDS -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <!-- PRACTICE -->
        <div class="bg-slate-800/90 border border-emerald-500/40 rounded-2xl p-6 shadow-2xl backdrop-blur">
          <div class="flex items-center gap-3 mb-3">
            <span class="text-3xl">🎯</span>
            <div>
              <h2 class="text-lg font-bold text-emerald-300">Practice</h2>
              <p class="text-xs text-slate-400">Solo penalty drills vs the keeper</p>
            </div>
          </div>
          <p class="text-sm text-slate-300 mb-4">Pick any level to practise a math topic and score 10 goals.</p>
          <button onclick="startPractice(1)" class="w-full bg-gradient-to-r from-emerald-500 to-teal-600 hover:from-emerald-400 hover:to-teal-500 text-slate-950 font-black text-lg py-3 px-6 rounded-xl shadow-lg transition transform active:scale-95 flex items-center justify-center gap-2">
            <i class="fas fa-futbol"></i> START PRACTICE
          </button>
        </div>

        <!-- PENALTY MATCH -->
        <div class="bg-slate-800/90 border border-sky-500/40 rounded-2xl p-6 shadow-2xl backdrop-blur">
          <div class="flex items-center gap-3 mb-3">
            <span class="text-3xl">⚔️</span>
            <div>
              <h2 class="text-lg font-bold text-sky-300">Penalty Match</h2>
              <p class="text-xs text-slate-400">1v1 vs your friend — same questions</p>
            </div>
          </div>
          <p class="text-sm text-slate-300 mb-4">Set your friend's kit, then race to 10 goals on identical questions. First to 10 wins.</p>
          <button onclick="openFriendProfileAndStart()" class="w-full bg-gradient-to-r from-sky-500 to-indigo-600 hover:from-sky-400 hover:to-indigo-500 text-white font-black text-lg py-3 px-6 rounded-xl shadow-lg transition transform active:scale-95 flex items-center justify-center gap-2">
            <i class="fas fa-users"></i> PLAY VS FRIEND
          </button>
        </div>
      </div>

      <!-- MY PROFILE -->
      <div class="bg-slate-900/70 border border-amber-500/30 rounded-xl p-4 text-left">
        <div class="flex items-center justify-between mb-3">
          <h3 class="text-sm font-bold text-amber-300 flex items-center gap-2"><i class="fas fa-user"></i> My Player Profile</h3>
          <div class="flex items-center gap-2">
            <span class="text-xs font-bold text-slate-200" id="profilePreviewName">Player</span>
            <span class="text-xs px-2 py-0.5 rounded bg-amber-500/20 text-amber-300 font-black" id="profilePreviewNumber">10</span>
          </div>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          <div class="flex items-center gap-2">
            <label class="text-xs text-slate-400 w-20">Name</label>
            <input id="myName" type="text" maxlength="20" placeholder="Your name"
                   class="flex-1 bg-slate-800 border border-slate-600 rounded-lg px-3 py-2 text-sm text-white placeholder-slate-500 focus:outline-none focus:border-amber-400" value="Player">
          </div>
          <div class="flex items-center gap-2">
            <label class="text-xs text-slate-400 w-20">Country</label>
            <input id="myCountryName" type="text" maxlength="20" placeholder="Country"
                   class="flex-1 bg-slate-800 border border-slate-600 rounded-lg px-3 py-2 text-sm text-white placeholder-slate-500 focus:outline-none focus:border-amber-400" value="My Country">
          </div>
          <div class="flex items-center gap-2">
            <label class="text-xs text-slate-400 w-20">Jersey</label>
            <input id="myCountryColor" type="color" value="#22c55e" class="w-14 h-9 rounded border border-slate-600 bg-slate-800 cursor-pointer">
            <input id="myJerseyNumber" type="number" min="1" max="99" placeholder="10"
                   class="w-20 bg-slate-800 border border-slate-600 rounded-lg px-3 py-2 text-sm text-white placeholder-slate-500 focus:outline-none focus:border-amber-400" value="10">
            <button onclick="saveMyProfile()" class="ml-auto bg-amber-500 hover:bg-amber-400 text-slate-950 text-xs font-bold px-4 py-2 rounded-lg transition">Save</button>
          </div>
        </div>
      </div>

      <!-- FRIEND PROFILE -->
      <div class="bg-slate-900/70 border border-sky-500/30 rounded-xl p-4 text-left">
        <div class="flex items-center justify-between mb-3">
          <h3 class="text-sm font-bold text-sky-300 flex items-center gap-2"><i class="fas fa-user-friends"></i> Friend Profile</h3>
          <div class="flex items-center gap-2">
            <span class="text-xs font-bold text-slate-200" id="friendPreviewName">Friend</span>
            <span class="text-xs px-2 py-0.5 rounded bg-sky-500/20 text-sky-300 font-black" id="friendPreviewNumber">9</span>
          </div>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          <div class="flex items-center gap-2">
            <label class="text-xs text-slate-400 w-20">Name</label>
            <input id="friendName" type="text" maxlength="20" placeholder="Friend's name"
                   class="flex-1 bg-slate-800 border border-slate-600 rounded-lg px-3 py-2 text-sm text-white placeholder-slate-500 focus:outline-none focus:border-sky-400" value="Friend">
          </div>
          <div class="flex items-center gap-2">
            <label class="text-xs text-slate-400 w-20">Country</label>
            <input id="friendCountryName" type="text" maxlength="20" placeholder="Friend's country"
                   class="flex-1 bg-slate-800 border border-slate-600 rounded-lg px-3 py-2 text-sm text-white placeholder-slate-500 focus:outline-none focus:border-sky-400" value="Rivals">
          </div>
          <div class="flex items-center gap-2">
            <label class="text-xs text-slate-400 w-20">Jersey</label>
            <input id="friendCountryColor" type="color" value="#ef4444" class="w-14 h-9 rounded border border-slate-600 bg-slate-800 cursor-pointer">
            <input id="friendJerseyNumber" type="number" min="1" max="99" placeholder="9"
                   class="w-20 bg-slate-800 border border-slate-600 rounded-lg px-3 py-2 text-sm text-white placeholder-slate-500 focus:outline-none focus:border-sky-400" value="9">
            <button onclick="saveFriendProfile()" class="ml-auto bg-sky-500 hover:bg-sky-400 text-slate-950 text-xs font-bold px-4 py-2 rounded-lg transition">Save</button>
          </div>
        </div>
      </div>

      <!-- PRACTICE LEVELS -->
      <div>
        <h3 class="text-sm font-bold text-emerald-300 mb-2 flex items-center gap-2"><i class="fas fa-list"></i> Practice Levels</h3>
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-4" id="levelGrid"></div>
      </div>
    </div>

    <!-- MATCH ARENA -->
    <div id="matchArena" class="hidden flex-col items-center justify-center space-y-4">

      <div class="w-full bg-slate-900/90 border border-amber-500/30 rounded-2xl p-4 shadow-xl flex justify-between items-center">
        <div class="flex items-center gap-3">
          <span class="text-2xl" id="stageFlag">⚽</span>
          <div>
            <div class="text-xs text-amber-400 uppercase tracking-wider font-semibold" id="matchTitle">Practice</div>
            <div class="text-sm font-bold text-slate-200" id="matchSub">Player — Adding Normal Numbers</div>
          </div>
        </div>
        <div class="flex items-center gap-4">
          <button onclick="qaSkipStage()" class="bg-indigo-600 hover:bg-indigo-500 text-white text-xs font-bold px-3 py-2 rounded-xl shadow border border-indigo-400/50 flex items-center gap-1.5 transition">
            <i class="fas fa-forward"></i> ⚡ QA Skip
          </button>
          <div class="text-center">
            <div class="text-xs text-slate-400" id="goalLabel">GOALS</div>
            <div class="text-2xl font-black text-emerald-400" id="goalCounter">0 / 10</div>
          </div>
        </div>
      </div>

      <!-- MATCH SCORE STRIP -->
      <div id="mpScoreStrip" class="hidden w-full bg-slate-900/80 border border-sky-500/40 rounded-2xl p-3 shadow-xl">
        <div class="flex items-center justify-between text-xs gap-2">
          <div class="text-center flex-1 min-w-0">
            <div class="text-slate-400 mb-0.5">You</div>
            <div id="mpYouName" class="font-bold text-emerald-300 truncate">Player</div>
            <div id="mpYouGoals" class="text-2xl font-black text-emerald-400">0</div>
          </div>
          <div class="text-amber-400 font-black text-lg px-2">VS</div>
          <div class="text-center flex-1 min-w-0">
            <div class="text-slate-400 mb-0.5">Friend</div>
            <div id="mpOppName" class="font-bold text-rose-300 truncate">Friend</div>
            <div id="mpOppGoals" class="text-2xl font-black text-rose-400">0</div>
          </div>
        </div>
        <div id="mpTurnTag" class="text-[11px] text-center text-amber-300 mt-1 font-bold">Your turn</div>
      </div>

      <!-- PITCH -->
      <div class="relative w-full h-96 pitch-grass rounded-3xl border-4 border-slate-600/60 overflow-hidden shadow-2xl flex flex-col justify-between items-center p-4">

        <div id="commentaryBanner" class="z-20 bg-slate-900/90 border border-slate-700 px-6 py-1.5 rounded-full text-xs font-bold text-amber-300 transition-all duration-300 opacity-0 transform -translate-y-2 backdrop-blur-sm">
          Aim for the top corner!
        </div>

        <div id="goalFrame" class="goal-frame-3d relative w-80 h-40 bg-slate-800/30 shadow-2xl flex justify-center items-end z-10 overflow-visible">
          <div id="goalNet" class="goal-net-3d absolute inset-0 rounded-t-lg overflow-hidden">
            <div class="goal-net-mesh"></div>
            <div class="absolute inset-0 bg-gradient-to-b from-transparent via-transparent to-black/50 rounded-t-lg"></div>
          </div>
          <div class="absolute top-3 left-4 w-10 h-10 rounded-full border-2 border-dashed border-yellow-400/80 flex items-center justify-center text-sm text-yellow-300 target-corner animate-pulse shadow-lg shadow-yellow-500/20 z-20">🎯</div>
          <div class="absolute top-3 right-4 w-10 h-10 rounded-full border-2 border-dashed border-yellow-400/80 flex items-center justify-center text-sm text-yellow-300 target-corner animate-pulse shadow-lg shadow-yellow-500/20 z-20">🎯</div>

          <!-- KEEPER -->
          <div id="keeperWrapper" class="absolute bottom-0 z-30 transition-all duration-300" style="transform-origin: center bottom; filter: drop-shadow(0 6px 8px rgba(0,0,0,0.6)) drop-shadow(0 0 10px rgba(255,215,0,0.3));">
            <svg id="keeperSVG" width="100" height="125" viewBox="0 0 100 125" xmlns="http://www.w3.org/2000/svg">
              <defs>
                <radialGradient id="stickGlow" cx="50%" cy="50%" r="50%">
                  <stop offset="0%" stop-color="#fde68a" stop-opacity="0.6"/><stop offset="100%" stop-color="#fde68a" stop-opacity="0"/>
                </radialGradient>
                <linearGradient id="keeperJersey" x1="0%" y1="0%" x2="0%" y2="100%">
                  <stop offset="0%" stop-color="#22c55e"/><stop offset="55%" stop-color="#16a34a"/><stop offset="100%" stop-color="#0f5a2a"/>
                </linearGradient>
                <linearGradient id="keeperJerseyShine" x1="0%" y1="0%" x2="100%" y2="0%">
                  <stop offset="0%" stop-color="#ffffff" stop-opacity="0.35"/><stop offset="45%" stop-color="#ffffff" stop-opacity="0"/>
                </linearGradient>
                <linearGradient id="keeperShorts" x1="0%" y1="0%" x2="0%" y2="100%">
                  <stop offset="0%" stop-color="#1e293b"/><stop offset="100%" stop-color="#0f172a"/>
                </linearGradient>
              </defs>
              <ellipse cx="50" cy="65" rx="42" ry="55" fill="url(#stickGlow)"/>
              <ellipse cx="50" cy="122" rx="24" ry="4" fill="#000" opacity="0.35"/>
              <g stroke-linecap="round" fill="none">
                <g stroke="#0a0a0a" stroke-width="9">
                  <line x1="50" y1="88" x2="38" y2="118"/><line x1="50" y1="88" x2="62" y2="118"/>
                </g>
                <g stroke="#f8fafc" stroke-width="5">
                  <line x1="50" y1="88" x2="38" y2="118"/><line x1="50" y1="88" x2="62" y2="118"/>
                </g>
              </g>
              <path d="M34 116 L42 116 L40 122 L32 122 Z" fill="#111827"/>
              <path d="M58 116 L66 116 L68 122 L60 122 Z" fill="#111827"/>
              <rect x="32" y="120" width="10" height="2" rx="1" fill="#f59e0b"/>
              <rect x="58" y="120" width="10" height="2" rx="1" fill="#f59e0b"/>
              <path d="M33 76 L67 76 L69 90 Q69 93 66 93 L58 93 L56 84 L44 84 L42 93 L34 93 Q31 93 31 90 Z" fill="url(#keeperShorts)" stroke="#0a0a0a" stroke-width="1.5"/>
              <line x1="50" y1="78" x2="50" y2="87" stroke="#334155" stroke-width="1.5"/>
              <path d="M28 52 Q28 44 36 42 L64 42 Q72 44 72 52 L73 78 Q73 82 69 82 L31 82 Q27 82 27 78 Z"
                    fill="url(#keeperJersey)" stroke="#0a0a0a" stroke-width="2" stroke-linejoin="round"/>
              <path d="M29 54 L29 76 Q29 79 32 79 L38 79 L38 54 Z" fill="url(#keeperJerseyShine)"/>
              <path d="M40 42 Q50 49 60 42" fill="none" stroke="#dcfce7" stroke-width="2.5" stroke-linecap="round"/>
              <text x="50" y="70" font-family="Arial Black, sans-serif" font-size="17" font-weight="900" fill="#f0fdf4" text-anchor="middle" opacity="0.95" style="text-shadow: 0 1px 2px #000;">1</text>
              <g stroke-linecap="round" fill="none">
                <g stroke="#0a0a0a" stroke-width="9">
