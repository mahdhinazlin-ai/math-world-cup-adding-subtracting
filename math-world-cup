  <script>
    // ============================================================
    //  STATE
    // ============================================================
    let goalsScored = 0;          // practice: my goals. match: current kicker's goals (see MP)
    let totalShots = 0;
    let isProcessingShot = false;
    let currentLevel = 1;
    let currentQuestion = null;
    let userLevelStars = JSON.parse(localStorage.getItem('mwc_stars') || '{}');

    let myProfile = JSON.parse(localStorage.getItem('mwc_profile') || 'null') || {
      name: "Player", country: "My Country", color: "#22c55e", number: 10
    };
    let friendProfile = JSON.parse(localStorage.getItem('mwc_friend') || 'null') || {
      name: "Friend", country: "Rivals", color: "#ef4444", number: 9
    };

    const QUESTION_TIME = 20;
    let timeLeft = QUESTION_TIME;
    let timerInterval = null;
    const TIMER_CIRCUMFERENCE = 2 * Math.PI * 17;

    // ============================================================
    //  MATCH STATE (local hot-seat 1v1)
    // ============================================================
    const M = {
      active: false,
      turn: "me",            // "me" | "friend"
      meGoals: 0,
      friendGoals: 0,
      seed: 0,
      questionIndex: 0,
      target: 10,
      finished: false
    };

    const TOURNAMENT_LEVELS = [
      { id: 1, name: "Level 1: Warm-Up", desc: "Adding Normal Numbers", type: "add_normal" },
      { id: 2, name: "Level 2: Negative Numbers", desc: "Adding Directed Numbers", type: "add_directed" },
      { id: 3, name: "Level 3: Fractions", desc: "Adding Fractions", type: "add_fractions" },
      { id: 4, name: "Level 4: Decimals", desc: "Adding Decimals", type: "add_decimals" },
      { id: 5, name: "Level 5: Subtraction Mix", desc: "Subtractions across all types", type: "sub_mix" },
      { id: 6, name: "Level 6: Multiplication Mix", desc: "Multiplication & Subtraction", type: "mul_mix" },
      { id: 7, name: "Level 7: Division Mix", desc: "Division & Subtraction", type: "div_mix" }
    ];

    // ============================================================
    //  COLOUR HELPERS
    // ============================================================
    function lighten(hex, amt) {
      const n = parseInt(hex.slice(1), 16);
      let r = (n >> 16) + amt, g = ((n >> 8) & 0xff) + amt, b = (n & 0xff) + amt;
      r = Math.min(255, Math.max(0, r)); g = Math.min(255, Math.max(0, g)); b = Math.min(255, Math.max(0, b));
      return "#" + ((1 << 24) + (r << 16) + (g << 8) + b).toString(16).slice(1);
    }
    function darken(hex, amt) {
      const n = parseInt(hex.slice(1), 16);
      let r = (n >> 16) - amt, g = ((n >> 8) & 0xff) - amt, b = (n & 0xff) - amt;
      r = Math.min(255, Math.max(0, r)); g = Math.min(255, Math.max(0, g)); b = Math.min(255, Math.max(0, b));
      return "#" + ((1 << 24) + (r << 16) + (g << 8) + b).toString(16).slice(1);
    }

    // ============================================================
    //  PROFILES
    // ============================================================
    function loadProfileInputs() {
      document.getElementById('myName').value = myProfile.name;
      document.getElementById('myCountryName').value = myProfile.country;
      document.getElementById('myCountryColor').value = myProfile.color;
      document.getElementById('myJerseyNumber').value = myProfile.number;

      document.getElementById('friendName').value = friendProfile.name;
      document.getElementById('friendCountryName').value = friendProfile.country;
      document.getElementById('friendCountryColor').value = friendProfile.color;
      document.getElementById('friendJerseyNumber').value = friendProfile.number;

      updateMyPreview();
      updateFriendPreview();
    }
    function updateMyPreview() {
      document.getElementById('profilePreviewName').textContent = document.getElementById('myName').value || "Player";
      document.getElementById('profilePreviewNumber').textContent = document.getElementById('myJerseyNumber').value || "10";
    }
    function updateFriendPreview() {
      document.getElementById('friendPreviewName').textContent = document.getElementById('friendName').value || "Friend";
      document.getElementById('friendPreviewNumber').textContent = document.getElementById('friendJerseyNumber').value || "9";
    }
    function saveMyProfile() {
      const name = document.getElementById('myName').value.trim() || "Player";
      const country = document.getElementById('myCountryName').value.trim() || "My Country";
      const color = document.getElementById('myCountryColor').value || "#22c55e";
      let number = parseInt(document.getElementById('myJerseyNumber').value, 10);
      if (!number || number < 1) number = 10;
      if (number > 99) number = 99;
      myProfile = { name, country, color, number };
      localStorage.setItem('mwc_profile', JSON.stringify(myProfile));
      updateMyPreview();
      renderLevelHub();
      toast("Profile saved", event.target);
    }
    function saveFriendProfile() {
      const name = document.getElementById('friendName').value.trim() || "Friend";
      const country = document.getElementById('friendCountryName').value.trim() || "Rivals";
      const color = document.getElementById('friendCountryColor').value || "#ef4444";
      let number = parseInt(document.getElementById('friendJerseyNumber').value, 10);
      if (!number || number < 1) number = 9;
      if (number > 99) number = 99;
      friendProfile = { name, country, color, number };
      localStorage.setItem('mwc_friend', JSON.stringify(friendProfile));
      updateFriendPreview();
      toast("Friend saved", event.target);
    }
    function toast(msg, btn) {
      if (!btn) return;
      const old = btn.textContent;
      btn.textContent = "Saved ✓";
      setTimeout(() => { btn.textContent = old; }, 1000);
    }

    // ============================================================
    //  HUB / LEVELS
    // ============================================================
    function renderLevelHub() {
      const grid = document.getElementById('levelGrid');
      grid.innerHTML = '';
      TOURNAMENT_LEVELS.forEach(lvl => {
        const stars = userLevelStars[lvl.id] || 0;
        const card = document.createElement('div');
        card.className = "bg-slate-800/90 border border-slate-700/80 hover:border-amber-500/50 rounded-xl p-4 transition transform hover:-translate-y-1 cursor-pointer flex flex-col justify-between";
        card.onclick = () => startPractice(lvl.id);
        card.innerHTML = `
          <div>
            <div class="flex justify-between items-start mb-2">
              <span class="text-xs font-bold px-2 py-0.5 rounded bg-amber-500/20 text-amber-300">${lvl.name}</span>
              <span class="text-amber-400 text-xs">⭐ ${stars}/3</span>
            </div>
            <div class="flex items-center gap-2 mb-1">
              <h4 class="font-bold text-slate-100 text-sm">${lvl.desc}</h4>
            </div>
            <p class="text-xs text-slate-400">Practise solo</p>
          </div>
          <button class="mt-4 w-full bg-emerald-600/80 hover:bg-emerald-500 text-slate-950 text-xs font-bold py-2 rounded-lg transition">Practise</button>
        `;
        grid.appendChild(card);
      });
    }

    function applyMyKit() {
      const c = myProfile.color;
      document.getElementById('jerseyTop').setAttribute('stop-color', lighten(c, 40));
      document.getElementById('jerseyMid').setAttribute('stop-color', c);
      document.getElementById('jerseyBot').setAttribute('stop-color', darken(c, 40));
      document.getElementById('jerseyNumber').textContent = myProfile.number;
      document.getElementById('kickerWrapper').style.filter =
        `drop-shadow(0 6px 8px rgba(0,0,0,0.6)) drop-shadow(0 0 10px ${c}88)`;
    }
    function applyFriendKit() {
      const c = friendProfile.color;
      document.getElementById('jerseyTop').setAttribute('stop-color', lighten(c, 40));
      document.getElementById('jerseyMid').setAttribute('stop-color', c);
      document.getElementById('jerseyBot').setAttribute('stop-color', darken(c, 40));
      document.getElementById('jerseyNumber').textContent = friendProfile.number;
      document.getElementById('kickerWrapper').style.filter =
        `drop-shadow(0 6px 8px rgba(0,0,0,0.6)) drop-shadow(0 0 10px ${c}88)`;
    }

    // ============================================================
    //  PRACTICE
    // ============================================================
    function startPractice(lvlId) {
      M.active = false;
      currentLevel = lvlId;
      goalsScored = 0;
      totalShots = 0;
      document.getElementById('mpScoreStrip').classList.add('hidden');
      document.getElementById('levelHub').classList.add('hidden');
      document.getElementById('matchArena').classList.remove('hidden');
      document.getElementById('matchArena').classList.add('flex');

      const config = TOURNAMENT_LEVELS.find(l => l.id === lvlId) || TOURNAMENT_LEVELS[0];
      document.getElementById('matchTitle').textContent = "Practice — " + config.name;
      document.getElementById('matchSub').textContent = `${myProfile.name} (${myProfile.country}) — ${config.desc}`;
      document.getElementById('goalLabel').textContent = "GOALS";
      document.getElementById('goalCounter').innerText = `0 / 10`;
      document.getElementById('qTurnLabel').textContent = "Solve to Shoot";
      applyMyKit();
      nextQuestion();
    }

    function openFriendProfileAndStart() {
      // Ensure the friend profile panel is visible at the hub and scroll to it
      document.getElementById('friendName').scrollIntoView({ behavior: 'smooth', block: 'center' });
      // Start a match right away using the current friend profile
      startMatch();
    }

    // ============================================================
    //  1v1 PENALTY MATCH (local hot-seat)
    // ============================================================
    function startMatch() {
      M.active = true;
      M.finished = false;
      M.turn = "me";
      M.meGoals = 0;
      M.friendGoals = 0;
      M.seed = Math.floor(Math.random() * 999999) + 1;
      M.questionIndex = 0;
      currentLevel = 1;
      goalsScored = 0;
      totalShots = 0;

      document.getElementById('levelHub').classList.add('hidden');
      document.getElementById('matchArena').classList.remove('hidden');
      document.getElementById('matchArena').classList.add('flex');
      document.getElementById('mpScoreStrip').classList.remove('hidden');
      document.getElementById('mpYouName').textContent = myProfile.name;
      document.getElementById('mpOppName').textContent = friendProfile.name;
      document.getElementById('mpYouGoals').textContent = 0;
      document.getElementById('mpOppGoals').textContent = 0;

      document.getElementById('matchTitle').textContent = "Penalty Match";
      document.getElementById('goalLabel').textContent = "GOALS";
      updateMatchTurnUI();
      nextQuestion();
    }

    function updateMatchTurnUI() {
      const isMe = M.turn === "me";
      const shooter = isMe ? myProfile : friendProfile;
      document.getElementById('mpYouGoals').textContent = M.meGoals;
      document.getElementById('mpOppGoals').textContent = M.friendGoals;
      document.getElementById('mpTurnTag').textContent = isMe ? "Your turn" : `${friendProfile.name}'s turn`;
      document.getElementById('qTurnLabel').textContent = isMe ? "Your turn — Solve to Shoot" : `${friendProfile.name}'s turn — Solve to Shoot`;
      document.getElementById('matchSub').textContent = `${shooter.name} (${shooter.country}) shooting`;
      document.getElementById('goalCounter').innerText = `You ${M.meGoals} – ${M.friendGoals} Friend`;

      if (isMe) applyMyKit(); else applyFriendKit();
    }

    // ============================================================
    //  QA SKIP
    // ============================================================
    function qaSkipStage() {
      if (M.active) { alert("QA Skip is disabled in penalty matches."); return; }
      stopTimer();
      alert(`⚡ QA Skip Triggered! Level ${currentLevel} completed instantly.`);
      userLevelStars[currentLevel] = 3;
      localStorage.setItem('mwc_stars', JSON.stringify(userLevelStars));
      document.getElementById('matchArena').classList.add('hidden');
      document.getElementById('levelHub').classList.remove('hidden');
      renderLevelHub();
    }

    // ============================================================
    //  TIMER
    // ============================================================
    function startTimer() {
      stopTimer();
      timeLeft = QUESTION_TIME;
      updateTimerDisplay();
      timerInterval = setInterval(() => {
        timeLeft--;
        updateTimerDisplay();
        if (timeLeft <= 0) { stopTimer(); handleTimeout(); }
      }, 1000);
    }
    function stopTimer() {
      if (timerInterval) { clearInterval(timerInterval); timerInterval = null; }
    }
    function updateTimerDisplay() {
      const ring = document.getElementById('timerRing');
      const text = document.getElementById('timerText');
      text.textContent = Math.max(0, timeLeft);
      const fraction = Math.max(0, timeLeft) / QUESTION_TIME;
      ring.style.strokeDashoffset = TIMER_CIRCUMFERENCE * (1 - fraction);
      let color = '#22c55e';
      if (timeLeft <= 5) {
        color = '#ef4444'; ring.classList.add('timer-danger');
        text.classList.remove('text-emerald-400', 'text-amber-400'); text.classList.add('text-rose-400');
      } else if (timeLeft <= 10) {
        color = '#f59e0b'; ring.classList.remove('timer-danger');
        text.classList.remove('text-emerald-400', 'text-rose-400'); text.classList.add('text-amber-400');
      } else {
        ring.classList.remove('timer-danger');
        text.classList.remove('text-rose-400', 'text-amber-400'); text.classList.add('text-emerald-400');
      }
      ring.style.stroke = color;
    }
    function resetTimerVisuals() {
      const ring = document.getElementById('timerRing');
      const text = document.getElementById('timerText');
      ring.classList.remove('timer-danger');
      ring.style.stroke = '#22c55e';
      text.classList.remove('text-rose-400', 'text-amber-400');
      text.classList.add('text-emerald-400');
      text.textContent = QUESTION_TIME;
      ring.style.strokeDashoffset = 0;
    }

    // ============================================================
    //  TIMEOUT
    // ============================================================
    function handleTimeout() {
      if (isProcessingShot) return;
      isProcessingShot = true;
      totalShots++;

      const ball = document.getElementById('soccerBall');
      const keeperWrapper = document.getElementById('keeperWrapper');
      const kickerWrapper = document.getElementById('kickerWrapper');
      const banner = document.getElementById('commentaryBanner');
      const keeperDivesRight = Math.random() > 0.5;

      kickerWrapper.classList.add('animate-kicker-swing');

      setTimeout(() => {
        kickerWrapper.classList.remove('animate-kicker-swing');
        kickerWrapper.classList.add('animate-kicker-follow');
        ball.classList.add(keeperDivesRight ? 'animate-ball-caught-right' : 'animate-ball-caught-left');
        keeperWrapper.classList.add(keeperDivesRight ? 'animate-catch-right' : 'animate-catch-left');
        keeperWrapper.style.filter = "drop-shadow(0 6px 8px rgba(0,0,0,0.6)) drop-shadow(0 0 20px rgba(250,204,21,1))";
        banner.innerText = "⏰ TIME'S UP! Keeper catches the ball!";
        banner.className = "z-20 bg-rose-950/90 border border-rose-500 px-6 py-1.5 rounded-full text-xs font-bold text-rose-300 opacity-100 transition-all duration-300 transform translate-y-0 backdrop-blur-sm shadow-lg shadow-rose-500/30";
      }, 350);

      setTimeout(() => {
        banner.className = "z-20 bg-slate-900/80 border border-slate-700 px-6 py-1.5 rounded-full text-xs font-semibold text-amber-300 transition-all duration-300 opacity-0 transform -translate-y-2 backdrop-blur-sm";
        afterShot(false);
      }, 1800);
    }

    // ============================================================
    //  RESET ACTORS
    // ============================================================
    function resetActors() {
      const ball = document.getElementById('soccerBall');
      const keeperWrapper = document.getElementById('keeperWrapper');
      const kickerWrapper = document.getElementById('kickerWrapper');
      ball.className = "ball-3d relative z-20";
      ball.style.transform = ""; ball.style.opacity = "1"; ball.style.transition = "";
      keeperWrapper.classList.remove('animate-dive-left','animate-dive-right','animate-catch-left','animate-catch-right');
      keeperWrapper.style.transform = "";
      keeperWrapper.style.filter = "drop-shadow(0 6px 8px rgba(0,0,0,0.6)) drop-shadow(0 0 10px rgba(255,215,0,0.3))";
      kickerWrapper.classList.remove('animate-kicker-runup','animate-kicker-swing','animate-kicker-follow');
      kickerWrapper.style.transform = "";
    }

    // ============================================================
    //  NEXT QUESTION
    // ============================================================
    function nextQuestion() {
      isProcessingShot = false;
      resetActors();
      resetTimerVisuals();

      const lvl = TOURNAMENT_LEVELS.find(l => l.id === currentLevel) || TOURNAMENT_LEVELS[0];

      if (M.active) {
        currentQuestion = generateSeededQuestion(lvl.type, M.seed, M.questionIndex);
      } else {
        currentQuestion = generateQuestionByType(lvl.type);
      }

      document.getElementById('questionText').innerText = currentQuestion.q;

      const optsContainer = document.getElementById('optionsContainer');
      optsContainer.innerHTML = '';
      currentQuestion.opts.forEach(opt => {
        const btn = document.createElement('button');
        btn.className = "bg-slate-700/80 hover:bg-slate-600 border border-slate-600 text-lg font-bold py-3.5 px-4 rounded-xl transition active:scale-95 text-amber-300 shadow-md hover:shadow-amber-500/20";
        btn.innerText = opt;
        btn.onclick = () => submitAnswer(opt);
        optsContainer.appendChild(btn);
      });

      startTimer();
    }

    // ============================================================
    //  SHARED (seeded) QUESTION GENERATION
    // ============================================================
    function mulberry32(seed) {
      return function() {
        seed |= 0; seed = (seed + 0x6D2B79F5) | 0;
        let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
        t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
        return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
      };
    }
    function generateSeededQuestion(type, seed, index) {
      const rng = mulberry32((seed || 1) * 7919 + index * 104729);
      const r = (n) => Math.floor(rng() * n);
      let q = "", ans = "", opts = [];
      if (type === "add_normal") {
        let a = r(20) + 1, b = r(20) + 1;
        q = `${a} + ${b} = ?`; ans = (a + b).toString();
        opts = [a + b, a + b + 2, a + b - 1, a + b + 5];
      } else if (type === "add_directed") {
        let a = r(15) - 8, b = r(15) - 8;
        q = `(${a}) + (${b}) = ?`; ans = (a + b).toString();
        opts = [a + b, a + b + 3, a + b - 2, -(a + b)];
      } else if (type === "add_fractions") {
        q = `1/4 + 2/4 = ?`; ans = `3/4`;
        opts = ["3/4", "2/4", "1/2", "3/8"];
      } else if (type === "add_decimals") {
        let a = (r(5) + 1).toFixed(1), b = (r(5) + 1).toFixed(1);
        q = `${a} + ${b} = ?`;
        ans = (parseFloat(a) + parseFloat(b)).toFixed(1);
        opts = [ans, (parseFloat(ans) + 0.5).toFixed(1), (parseFloat(ans) - 0.2).toFixed(1), (parseFloat(ans) + 1.1).toFixed(1)];
      } else {
        let a = r(25) + 5, b = r(15) + 1;
        q = `${a} - ${b} = ?`; ans = (a - b).toString();
        opts = [a - b, a - b + 2, a - b - 3, a + b];
      }
      opts = [...new Set(opts)].sort(() => rng() - 0.5);
      return { q, ans, opts };
    }

    function generateQuestionByType(type) {
      let q = "", ans = "", opts = [];
      if (type === "add_normal") {
        let a = Math.floor(Math.random() * 20) + 1, b = Math.floor(Math.random() * 20) + 1;
        q = `${a} + ${b} = ?`; ans = (a + b).toString();
        opts = [a + b, a + b + 2, a + b - 1, a + b + 5];
      } else if (type === "add_directed") {
        let a = Math.floor(Math.random() * 15) - 8, b = Math.floor(Math.random() * 15) - 8;
        q = `(${a}) + (${b}) = ?`; ans = (a + b).toString();
        opts = [a + b, a + b + 3, a + b - 2, -(a + b)];
      } else if (type === "add_fractions") {
        q = `1/4 + 2/4 = ?`; ans = `3/4`;
        opts = ["3/4", "2/4", "1/2", "3/8"];
      } else if (type === "add_decimals") {
        let a = (Math.random() * 5 + 1).toFixed(1), b = (Math.random() * 5 + 1).toFixed(1);
        q = `${a} + ${b} = ?`;
        ans = (parseFloat(a) + parseFloat(b)).toFixed(1);
        opts = [ans, (parseFloat(ans) + 0.5).toFixed(1), (parseFloat(ans) - 0.2).toFixed(1), (parseFloat(ans) + 1.1).toFixed(1)];
      } else {
        let a = Math.floor(Math.random() * 25) + 5, b = Math.floor(Math.random() * 15) + 1;
        q = `${a} - ${b} = ?`; ans = (a - b).toString();
        opts = [a - b, a - b + 2, a - b - 3, a + b];
      }
      opts = [...new Set(opts)].sort(() => Math.random() - 0.5);
      return { q, ans, opts };
    }

    // ============================================================
    //  SUBMIT ANSWER
    // ============================================================
    function submitAnswer(selectedOpt) {
      if (isProcessingShot) return;
      isProcessingShot = true;
      totalShots++;
      stopTimer();

      const ball = document.getElementById('soccerBall');
      const keeperWrapper = document.getElementById('keeperWrapper');
      const kickerWrapper = document.getElementById('kickerWrapper');
      const net = document.getElementById('goalNet');
      const banner = document.getElementById('commentaryBanner');

      const isCorrect = (selectedOpt.toString() === currentQuestion.ans.toString());
      const keeperDivesRight = Math.random() > 0.5;

      kickerWrapper.classList.add('animate-kicker-runup');

      setTimeout(() => {
        kickerWrapper.classList.remove('animate-kicker-runup');
        kickerWrapper.classList.add('animate-kicker-swing');
      }, 300);

      setTimeout(() => {
        kickerWrapper.classList.remove('animate-kicker-swing');
        kickerWrapper.classList.add('animate-kicker-follow');

        if (isCorrect) {
          const ballGoesLeft = keeperDivesRight;
          ball.classList.add(ballGoesLeft ? 'animate-kick-top-left-real' : 'animate-kick-top-right-real');
          keeperWrapper.classList.add(keeperDivesRight ? 'animate-dive-right' : 'animate-dive-left');
          keeperWrapper.style.filter = "drop-shadow(0 6px 8px rgba(0,0,0,0.6)) drop-shadow(0 0 16px rgba(239,68,68,0.6))";
          setTimeout(() => { net.classList.add('animate-net-bulge'); }, 350);
          banner.innerText = ballGoesLeft ? "⚽ GOAL! Top Left Corner Rocket!" : "⚽ GOAL! Top Right Corner Screamer!";
          banner.className = "z-20 bg-emerald-950/90 border border-emerald-500 px-6 py-1.5 rounded-full text-xs font-bold text-emerald-300 opacity-100 transition-all duration-300 transform translate-y-0 backdrop-blur-sm shadow-lg shadow-emerald-500/30";
        } else {
          ball.classList.add(keeperDivesRight ? 'animate-ball-caught-right' : 'animate-ball-caught-left');
          keeperWrapper.classList.add(keeperDivesRight ? 'animate-catch-right' : 'animate-catch-left');
          keeperWrapper.style.filter = "drop-shadow(0 6px 8px rgba(0,0,0,0.6)) drop-shadow(0 0 20px rgba(250,204,21,1))";
          banner.innerText = "🧤 CAUGHT! Stickman keeper grabs the ball!";
          banner.className = "z-20 bg-rose-950/90 border border-rose-500 px-6 py-1.5 rounded-full text-xs font-bold text-rose-300 opacity-100 transition-all duration-300 transform translate-y-0 backdrop-blur-sm shadow-lg shadow-rose-500/30";
        }
      }, 650);

      setTimeout(() => {
        net.classList.remove('animate-net-bulge');
        banner.className = "z-20 bg-slate-900/80 border border-slate-700 px-6 py-1.5 rounded-full text-xs font-semibold text-amber-300 transition-all duration-300 opacity-0 transform -translate-y-2 backdrop-blur-sm";
        afterShot(isCorrect);
      }, 1800);
    }

    // ============================================================
    //  AFTER SHOT
    // ============================================================
    function afterShot(isCorrect) {
      if (M.active) {
        // credit the current kicker
        if (isCorrect) {
          if (M.turn === "me") M.meGoals++; else M.friendGoals++;
        }
        updateMatchTurnUI();

        // Win check
        if (M.meGoals >= M.target || M.friendGoals >= M.target) {
          endMatch();
          return;
        }

        // Switch turn, advance shared question index
        M.turn = (M.turn === "me") ? "friend" : "me";
        M.questionIndex++;
        updateMatchTurnUI();
        nextQuestion();
      } else {
        // Practice
        if (isCorrect) {
          goalsScored++;
          document.getElementById('goalCounter').innerText = `${goalsScored} / 10`;
        }
        if (goalsScored >= 10) {
          alert(`🏆 Practice Complete! ${myProfile.name}, you scored 10 goals!`);
          userLevelStars[currentLevel] = 3;
          localStorage.setItem('mwc_stars', JSON.stringify(userLevelStars));
          document.getElementById('matchArena').classList.add('hidden');
          document.getElementById('levelHub').classList.remove('hidden');
          renderLevelHub();
          return;
        }
        nextQuestion();
      }
    }

    // ============================================================
    //  MATCH END
    // ============================================================
    function endMatch() {
      M.finished = true;
      stopTimer();
      const meWon = M.meGoals > M.friendGoals;
      const tie = M.meGoals === M.friendGoals;
      document.getElementById('goTitle').textContent = tie ? "Draw!" : (meWon ? "You Win! 🏆" : "You Lost");
      document.getElementById('goTitle').className = tie
        ? "text-2xl font-black text-amber-300"
        : (meWon ? "text-2xl font-black text-emerald-300" : "text-2xl font-black text-rose-300");
      document.getElementById('goScore').textContent = `${M.meGoals} – ${M.friendGoals}`;
      document.getElementById('goSub').textContent = tie
        ? "What a match! Both players scored the same."
        : `${meWon ? myProfile.name : friendProfile.name} won the penalty match.`;
      document.getElementById('gameOverModal').classList.remove('hidden');
    }

    function backToHubFromGame() {
      document.getElementById('gameOverModal').classList.add('hidden');
      document.getElementById('matchArena').classList.add('hidden');
      document.getElementById('levelHub').classList.remove('hidden');
      M.active = false;
      M.finished = false;
      M.turn = "me";
      M.meGoals = 0;
      M.friendGoals = 0;
      M.questionIndex = 0;
      document.getElementById('mpScoreStrip').classList.add('hidden');
      renderLevelHub();
    }

    // ============================================================
    //  MISC UI
    // ============================================================
    function openTutorial() { document.getElementById('tutorialModal').classList.remove('hidden'); }
    function closeTutorial() { document.getElementById('tutorialModal').classList.add('hidden'); }
    function showHint() { alert(`💡 Coach Hint:\nFor "${currentQuestion.q}", the correct answer is ${currentQuestion.ans}!`); }

    // Live previews on the inputs
    document.addEventListener('input', (e) => {
      if (e.target.id === 'myName' || e.target.id === 'myJerseyNumber') updateMyPreview();
      if (e.target.id === 'friendName' || e.target.id === 'friendJerseyNumber') updateFriendPreview();
    });

    window.onload = function() {
      loadProfileInputs();
      renderLevelHub();
    };
  </script>
</body>
